# Site
NEXT_PUBLIC_SITE_URL=https://your-mpic-domain.com
NEXTAUTH_URL=http://localhost:3000

# Auth (GitHub OAuth)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Image storage repo (public GitHub repo)
IMAGE_GITHUB_OWNER=
IMAGE_GITHUB_REPO=
IMAGE_GITHUB_BRANCH=main
IMAGE_GITHUB_TOKEN=

# Optional private repo for access logs (recommended)
ACCESS_LOGS_GITHUB_REPO=

# 管理员 GitHub 用户名，逗号分隔（可选，默认为 IMAGE_GITHUB_OWNER）
# ADMIN_GITHUB_USERNAMES=user1,user2

# Optional custom CDN base URL (replaces jsDelivr)
NEXT_PUBLIC_CDN_BASE_URL=
